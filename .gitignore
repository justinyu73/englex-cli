# Local Python environments, build output, and interpreter caches
.venv/
build/
*.egg-info/
__pycache__/
*.py[cod]

# Node / VS Code extension tooling (extension is dependency-free today; guard the future)
node_modules/
dist/
out/

# Packaged VS Code extension artifact (build on demand)
*.vsix

# Secrets and local machine state — never versioned (tools/wishlist_draft.py auto reads .env)
.env
.env.*
!.env.example
*.log
*.sqlite
*.db
